/** app.wxss — 医疗卫生简洁风格 **/
page {
  background: #f0f4f3;
  color: #1a2b3c;
  font-size: 28rpx;
  line-height: 1.55;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  box-sizing: border-box;
  padding: 24rpx 28rpx 48rpx;
  min-height: 100vh;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(13, 115, 119, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0d7377;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #e8f2f1;
}

.text-muted {
  color: #6b7c8c;
  font-size: 26rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #0d7377 0%, #14919b 100%);
  color: #ffffff !important;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 22rpx 32rpx;
  border: none;
  margin-top: 16rpx;
}

.btn-primary::after {
  border: none;
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: #e8f5f4;
  color: #0d7377;
  margin-right: 12rpx;
}

button {
  background: initial;
}

button:focus {
  outline: 0;
}
