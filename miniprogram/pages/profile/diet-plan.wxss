.page-diet {
  padding-top: 8rpx;
}

.page-diet .card {
  width: 100%;
  flex-shrink: 0;
  box-sizing: border-box;
}

.hint-line {
  font-size: 26rpx;
  line-height: 1.55;
  display: block;
  margin-bottom: 20rpx;
}

.demo-hint {
  display: block;
  margin-top: -8rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  line-height: 1.55;
}

/* 避免父级 flex 布局把 input 压成一条线；需固定高度 */
.diet-input-wrap {
  width: 100%;
  flex-shrink: 0;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.diet-input {
  display: block;
  width: 100%;
  height: 88rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  background: #f8fafb;
  border-radius: 12rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  border: 1rpx solid #e2e8f0;
  color: #0f172a;
}

.diet-query-btn {
  margin-top: 8rpx;
  text-align: center;
  line-height: 1.4;
  padding: 22rpx 32rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #0d7377 0%, #14919b 100%);
  box-sizing: border-box;
}

.diet-query-hover {
  opacity: 0.92;
}

.state-t {
  text-align: center;
  padding: 40rpx 24rpx;
  font-size: 28rpx;
}

.plan-card {
  margin-top: 8rpx;
}

.plan-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #0d7377;
  margin-bottom: 12rpx;
}

.plan-meta {
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.plan-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #0d7377;
  margin-bottom: 12rpx;
}

.plan-body {
  font-size: 28rpx;
  color: #334155;
  line-height: 1.75;
  white-space: pre-wrap;
  word-break: break-word;
}

.plan-extra {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e8f2f1;
  font-size: 26rpx;
  line-height: 1.55;
}

.plan-disclaimer {
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #e2e8f0;
  font-size: 22rpx;
  line-height: 1.55;
}
