.page-profile {
  padding-top: 8rpx;
}

.profile-header {
  display: flex;
  align-items: center;
  flex-direction: row;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #0d7377, #1ab5a6);
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.profile-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #0f172a;
}

.profile-sub {
  font-size: 24rpx;
}

.hint-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.menu {
  padding: 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
}

.menu-title {
  font-size: 30rpx;
  color: #1e293b;
}

.menu-arrow {
  font-size: 40rpx;
  color: #94a3b8;
  line-height: 1;
}

.menu-line {
  height: 1rpx;
  background: #f1f5f5;
  margin: 0 28rpx;
}
