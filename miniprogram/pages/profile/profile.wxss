.page-profile {
  padding-top: 8rpx;
}

.profile-header {
  display: flex;
  align-items: center;
  flex-direction: row;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #0d7377, #1ab5a6);
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.profile-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #0f172a;
}

.profile-sub {
  font-size: 24rpx;
}

.hint-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.menu {
  padding: 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
}

.menu-title {
  font-size: 30rpx;
  color: #1e293b;
}

.menu-arrow {
  font-size: 40rpx;
  color: #94a3b8;
  line-height: 1;
}

.menu-line {
  height: 1rpx;
  background: #f1f5f5;
  margin: 0 28rpx;
}

.identity-card .card-title {
  margin-bottom: 12rpx;
}

.identity-tip {
  display: block;
  font-size: 24rpx;
  line-height: 1.55;
  margin-bottom: 20rpx;
}

.identity-key {
  font-family: ui-monospace, monospace;
  font-size: 22rpx;
  color: #0d7377;
}

.identity-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f5;
  margin-bottom: 20rpx;
}

.identity-label {
  font-size: 28rpx;
  color: #64748b;
}

.identity-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  max-width: 420rpx;
  text-align: right;
}

.btn-switch-phone {
  background: #f0f9f8 !important;
  color: #0d7377 !important;
  border: 1rpx solid rgba(13, 115, 119, 0.35) !important;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 20rpx;
  margin-top: 4rpx;
}

.btn-switch-phone::after {
  border: none;
}

.switch-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.switch-dialog {
  width: 100%;
  max-width: 620rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 36rpx 32rpx 28rpx;
  box-sizing: border-box;
}

.switch-dialog-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 12rpx;
}

.switch-dialog-sub {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.switch-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  margin-bottom: 28rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  background: #f8fafb;
  border-radius: 12rpx;
  border: 1rpx solid #e2e8f0;
}

.switch-actions {
  display: flex;
  gap: 20rpx;
}

.switch-btn {
  flex: 1;
  font-size: 28rpx;
  padding: 18rpx 0;
  border-radius: 12rpx;
  margin: 0;
}

.switch-btn::after {
  border: none;
}

.switch-btn.ghost {
  background: #f1f5f9 !important;
  color: #475569 !important;
}

.switch-btn.primary {
  background: linear-gradient(135deg, #0d7377 0%, #14919b 100%) !important;
  color: #ffffff !important;
}
