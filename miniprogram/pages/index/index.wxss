.page-home {
  width: 100%;
  box-sizing: border-box;
  padding-bottom: 32rpx;
}

.hero {
  background: linear-gradient(145deg, #0d7377 0%, #14a89e 55%, #0f5c5f 100%);
  border-radius: 24rpx;
  padding: 40rpx 32rpx 36rpx;
  margin-bottom: 24rpx;
  color: #ffffff;
  box-shadow: 0 8rpx 32rpx rgba(13, 115, 119, 0.25);
  position: relative;
  overflow: hidden;
}

.hero-decor {
  position: absolute;
  right: -20%;
  bottom: -40%;
  width: 70%;
  height: 80%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.12) 0%, transparent 70%);
  pointer-events: none;
}

.hero-title {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.45;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
}

.hero-sub {
  font-size: 24rpx;
  opacity: 0.92;
  position: relative;
  z-index: 1;
}

.intro-text {
  font-size: 28rpx;
  color: #334155;
  line-height: 1.65;
}

.notice-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef2f2;
}

.notice-item-hover {
  opacity: 0.88;
}

.notice-item:last-child {
  border-bottom: none;
}

.notice-row-arrow {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.35;
  flex-shrink: 0;
  margin-left: 12rpx;
  transform: rotate(-90deg);
}

.notice-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #14919b;
  margin-right: 20rpx;
  flex-shrink: 0;
  align-self: flex-start;
  margin-top: 14rpx;
}

.notice-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.notice-title {
  font-size: 28rpx;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.notice-date {
  font-size: 24rpx;
}

.quick-card {
  padding-bottom: 8rpx;
}

.quick-list {
  margin-top: 8rpx;
}

.quick-row {
  display: flex;
  align-items: center;
  padding: 24rpx 8rpx 24rpx 4rpx;
  border-bottom: 1rpx solid #eef2f2;
}

.quick-row-last {
  border-bottom: none;
}

.quick-badge {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #e8f5f4 0%, #d8eeec 100%);
  border: 2rpx solid rgba(13, 115, 119, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.quick-badge-alt {
  background: linear-gradient(145deg, #e3f2f1 0%, #d0ebe8 100%);
}

.quick-badge-alt2 {
  background: linear-gradient(145deg, #e5f4f6 0%, #d2ecf0 100%);
}

.quick-badge-alt3 {
  background: linear-gradient(145deg, #eaf6f5 0%, #d9efed 100%);
}

.quick-badge-img {
  width: 48rpx;
  height: 48rpx;
}

.quick-row-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.quick-row-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 6rpx;
}

.quick-row-desc {
  font-size: 24rpx;
  line-height: 1.4;
}

.quick-row-arrow {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.45;
  flex-shrink: 0;
  transform: rotate(-90deg);
}

.notice-empty-hint {
  padding: 24rpx 8rpx 8rpx;
  font-size: 26rpx;
}
