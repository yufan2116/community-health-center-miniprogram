@import "../appointments/appointments.wxss";

.art-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.art-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  flex: 1;
  min-width: 200rpx;
}

.pub-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #e8f5f4;
  color: #0d7377;
}

.draft-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #f1f5f9;
  color: #64748b;
}

.art-sum {
  font-size: 26rpx;
  display: block;
  line-height: 1.45;
  margin-bottom: 8rpx;
}

.art-date {
  font-size: 24rpx;
}

.art-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.art-body {
  padding-bottom: 8rpx;
}

.art-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.art-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f1f5f9;
}

.art-main {
  flex: 1;
  min-width: 0;
}

.art-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f1f5f5;
}

.btn-mini {
  background: #f0f9f8 !important;
  color: #0d7377 !important;
  border: 1rpx solid #b8e0dd !important;
}

.btn-mini-danger {
  background: #fef2f2 !important;
  color: #b91c1c !important;
  border-color: #fecaca !important;
}
