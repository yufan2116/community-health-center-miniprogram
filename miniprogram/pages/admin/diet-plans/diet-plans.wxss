@import "../article-edit/article-edit.wxss";

.dp-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.dp-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  flex: 1;
}

.btn-text-del {
  font-size: 26rpx;
  color: #b91c1c;
  flex-shrink: 0;
}

.dp-line {
  font-size: 24rpx;
  display: block;
  margin-bottom: 8rpx;
}

.dp-advice {
  font-size: 26rpx;
  color: #334155;
  line-height: 1.55;
  white-space: pre-wrap;
}
