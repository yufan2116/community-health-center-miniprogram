@import "../login/login.wxss";

.filter-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}

.filter-label {
  font-size: 28rpx;
  color: #334155;
}

.filter-picker {
  font-size: 28rpx;
  color: #0d7377;
  padding: 12rpx 20rpx;
  background: #f0f9f8;
  border-radius: 10rpx;
}

.item-card {
  margin-bottom: 16rpx;
}

.row-line {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid #f1f5f5;
}

.row-line:last-child {
  border-bottom: none;
}

.k {
  color: #64748b;
}

.v {
  color: #0f172a;
  max-width: 420rpx;
  text-align: right;
}

.state-center {
  text-align: center;
  padding: 48rpx;
  font-size: 28rpx;
}

.export-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #64748b;
}

.export-second {
  margin-top: 16rpx;
}
