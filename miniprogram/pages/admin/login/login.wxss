page {
  background: #f0f4f3;
  height: 100%;
}

.admin-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.admin-page-inner {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: stretch;
  box-sizing: border-box;
  padding: 48rpx 28rpx 120rpx;
}

.admin-card {
  width: 100%;
  box-sizing: border-box;
}

.admin-tip {
  font-size: 26rpx;
  line-height: 1.6;
  display: block;
  margin-bottom: 32rpx;
}

.admin-field {
  margin-bottom: 28rpx;
}

.admin-label {
  display: block;
  font-size: 28rpx;
  color: #475569;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.admin-input {
  width: 100%;
  box-sizing: border-box;
  padding: 26rpx 24rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  border: 2rpx solid #cbd5e1;
  font-size: 30rpx;
  color: #0f172a;
  min-height: 88rpx;
  line-height: 1.4;
}

.login-placeholder {
  color: #94a3b8;
  font-size: 30rpx;
}

.login-foot-hint {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.login-btn {
  width: 100%;
  margin-top: 24rpx;
}
