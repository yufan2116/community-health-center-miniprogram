<scroll-view class="admin-scroll" scroll-y>
  <view class="admin-page-inner">
    <view class="card admin-card">
      <view class="card-title">管理员登录</view>
      <text class="text-muted admin-tip">演示独立账号，与普通居民无关。当前为本地校验（账号 admin，密码 admin123）。登录后可使用「初始化演示数据」写入本机 Storage 示例。</text>
      <view class="admin-field">
        <text class="admin-label">账号</text>
        <input
          class="admin-input"
          type="text"
          placeholder="admin"
          placeholder-class="login-placeholder"
          value="{{username}}"
          bindinput="onUser"
        />
      </view>
      <view class="admin-field">
        <text class="admin-label">密码</text>
        <input
          class="admin-input"
          password
          placeholder="admin123"
          placeholder-class="login-placeholder"
          value="{{password}}"
          bindinput="onPass"
        />
      </view>
      <text class="login-foot-hint text-muted">若占位符异常，请直接输入 admin / admin123</text>
      <button class="btn-primary login-btn" loading="{{loading}}" bindtap="submit">
        登录
      </button>
    </view>
  </view>
</scroll-view>
