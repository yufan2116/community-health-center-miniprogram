@import "../login/login.wxss";

.art-missing {
  padding: 80rpx 40rpx;
  line-height: 1.65;
  text-align: center;
}

.admin-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 120rpx;
  padding: 22rpx;
  background: #f8fafb;
  border-radius: 12rpx;
  border: 1rpx solid #e2e8f0;
  font-size: 28rpx;
}

.admin-textarea.large {
  min-height: 280rpx;
}

.picker-like {
  line-height: normal;
}

.pub-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
  padding: 8rpx 0;
}

.btn-del {
  margin-top: 24rpx;
  background: #fef2f2;
  color: #b91c1c;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 22rpx;
  border: 1rpx solid #fecaca;
}

.btn-del::after {
  border: none;
}

.admin-hint {
  display: block;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.45;
  margin-bottom: 12rpx;
}

.art-cover-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.art-cover-preview {
  width: 100%;
  height: 220rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
}

.art-cover-placeholder {
  width: 100%;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  border: 1rpx dashed #cbd5e1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #94a3b8;
}

.art-cover-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.btn-mini-muted {
  background: #f1f5f9;
  color: #475569;
}

.btn-mini {
  background: #f0f9f8 !important;
  color: #0d7377 !important;
  border: 1rpx solid #b8e0dd !important;
  font-size: 24rpx;
}

.preset-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.preset-label {
  font-size: 26rpx;
  color: #334155;
  flex-shrink: 0;
}

.preset-picker {
  flex: 1;
  min-width: 200rpx;
}
